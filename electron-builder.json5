// @see https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.pagorium.pixelgrid",
  "productName": "PixelGrid",
  "copyright": "Copyright © Pagorium Technologies",
  "asar": true,
  "directories": {
    "buildResources": "build",
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "extraMetadata": {
    "name": "pixelgrid",
    "author": {
      "name": "Pagorium Technologies",
      "email": "hello@pagorium.com",
      "url": "https://pagorium.com"
    }
  },
  "icon": "build/icon.png",
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "build/icon.icns",
    "darkModeSupport": true,
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
    "identity": null
  },
  "dmg": {
    "title": "${productName} ${version}",
    "icon": "build/icon.icns",
    "backgroundColor": "#1e1f22",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },
  "win": {
    "icon": "build/icon.ico",
    "publisherName": "Pagorium Technologies",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PixelGrid",
    "uninstallDisplayName": "PixelGrid",
    "license": "LICENSE"
  },
  "linux": {
    "icon": "build/icon.png",
    "category": "Development",
    "maintainer": "Pagorium Technologies <hello@pagorium.com>",
    "vendor": "Pagorium Technologies",
    "synopsis": "Navegador multipanel para previsualizar sitios en varios dispositivos",
    "description": "PixelGrid es una herramienta de Pagorium Technologies para diseñar y probar interfaces responsive en múltiples viewports a la vez.",
    "desktop": {
      "Name": "PixelGrid",
      "Comment": "Previsualización multipanel por Pagorium Technologies",
      "Categories": "Development;WebDevelopment;",
      "StartupWMClass": "PixelGrid"
    },
    "target": [
      "AppImage",
      "deb"
    ],
    "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "pagorium",
      "repo": "pixelgrid",
      "releaseType": "release"
    }
  ]
}
