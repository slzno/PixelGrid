{
  "name": "pixelgrid",
  "private": true,
  "version": "0.1.0",
  "description": "Navegador multipanel para previsualizar y probar sitios web en múltiples dispositivos. Creado por Pagorium Technologies.",
  "productName": "PixelGrid",
  "author": {
    "name": "Pagorium Technologies",
    "email": "hello@pagorium.com",
    "url": "https://pagorium.com"
  },
  "contributors": [
    {
      "name": "Pagorium Technologies",
      "email": "hello@pagorium.com",
      "url": "https://pagorium.com"
    }
  ],
  "license": "UNLICENSED",
  "homepage": "https://pagorium.com",
  "bugs": {
    "url": "https://pagorium.com",
    "email": "hello@pagorium.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pagorium/pixelgrid.git"
  },
  "keywords": [
    "pixelgrid",
    "responsive",
    "multipane",
    "browser",
    "electron",
    "pagorium",
    "devtools",
    "viewport"
  ],
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "tsc && vite build && electron-builder",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "pack": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
